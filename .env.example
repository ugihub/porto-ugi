# Environment Variables
# Copy this file to .env and fill in your values

# Supabase Configuration (Optional - for theme persistence)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-side only, configure this in Vercel Environment Variables.
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-medium-latest

# Optional live WarehouseFlow demo. Both flags must be explicitly true.
ENABLE_WAREHOUSEFLOW_LIVE_DEMO=false
VITE_ENABLE_WAREHOUSEFLOW_LIVE_DEMO=false
